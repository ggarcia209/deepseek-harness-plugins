{
  "name": "dsh-workspace-rules",
  "version": "0.1.0",
  "description": "DSH plugin: always-on workspace rules from a per-repo directory (RULE_LOCATION_DIR, default .dsh/rules)",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js"
  },
  "files": [
    "index.js",
    "rules.js",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-agent": "*",
    "@deepseek-ai/dsh-llm": "*",
    "@deepseek-ai/dsh-session": "*"
  }
}
